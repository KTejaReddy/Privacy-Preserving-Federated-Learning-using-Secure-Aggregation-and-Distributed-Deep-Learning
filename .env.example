# ---------------------------------------------------------------------------
# Federated AI Platform — environment variables
# Copy to .env and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- core ---
ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- database (SQLite by default; PostgreSQL in docker) ---
# DATABASE_URL=sqlite:///./federated_platform.db
# DATABASE_URL=postgresql+psycopg2://federated:federated@localhost:5432/federated_ai

# --- redis / celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# --- optional heavy AI libs (torch/tf/shap/...) ---
ENABLE_HEAVY_DEPS=false

# --- secure aggregation tuning ---
# MASK_KEY_BYTES=32
# AES_KEY_BYTES=32
# RSA_KEY_BITS=2048
# MAX_PRIVACY_BUDGET=8.0

# --- docker compose ---
# WEB_PORT=8080
